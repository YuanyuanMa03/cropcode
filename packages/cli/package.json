{
  "name": "@YuanyuanMa03/cropcode-cli",
  "version": "2.1.0",
  "description": "CropCode CLI - AI coding agent for agricultural research, powered by multi-provider LLMs",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/YuanyuanMa03/cropcode.git"
  },
  "bin": {
    "cropcode": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist/cli.js",
    "dist/chunks/**",
    "dist/templates/**",
    "dist/bundled/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "bundle": "node ../../scripts/esbuild.config.js",
    "build": "npm run typecheck && npm run bundle && node ../../scripts/copy-bundle-assets.js && node -e \"import('node:fs').then(f => f.chmodSync('dist/cli.js', 0o755))\"",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "test": "node src/tests/run-tests.mjs"
  },
  "dependencies": {
    "@YuanyuanMa03/cropcode-core": "file:../core",
    "chalk": "^5.6.2",
    "gradient-string": "^3.0.0",
    "ignore": "^7.0.5",
    "ink": "^7.0.4",
    "ink-gradient": "^4.0.1",
    "react": "^19.2.5"
  }
}
