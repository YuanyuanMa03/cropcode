{
  "name": "@YuanyuanMa03/cropcode",
  "version": "1.1.0",
  "description": "CropCode - AI coding agent CLI powered by LLM",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/YuanyuanMa03/cropcode.git"
  },
  "homepage": "https://github.com/YuanyuanMa03/cropcode",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bin": {
    "cropcode": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist/cli.js",
    "dist/bundled/**",
    "templates/tools/**",
    "templates/prompts/**",
    "templates/skills/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "bundle": "esbuild ./src/cli.tsx --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" --jsx=automatic --jsx-import-source=react --packages=external --log-override:empty-import-meta=silent && node scripts/copy_bundle_assets.js",
    "bundle:portable": "node scripts/build-portable.mjs",
    "package:all": "npm run bundle:portable && node scripts/package-distributions.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build": "npm run check && npm run bundle && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "node src/tests/run-tests.mjs",
    "test:single": "tsx --test",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "ejs": "^5.0.2",
    "gradient-string": "^3.0.0",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.5",
    "ink": "^7.0.4",
    "ink-gradient": "^4.0.1",
    "openai": "^6.35.0",
    "react": "^19.2.5",
    "undici": "^7.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/ejs": "^3.1.5",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "terminal",
    "llm",
    "developer-tools"
  ],
  "bugs": {
    "url": "https://github.com/mayuanyuan/cropcode/issues"
  },
  "author": "mayuanyuan"
}
